{
  "manifest_version": 3,
  "name": "Sig Scout",
  "version": "1.0.0",
  "description": "Catch and check signed PGP blocks: scans the current page for signed messages and checks them against keys you've chosen to trust.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": ["https://*/*", "http://*/*"],
  "minimum_chrome_version": "100"
}
